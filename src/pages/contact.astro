---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactMethods = [
  { type: "Email", value: "murphy@certirun.com", href: "mailto:murphy@certirun.com" },
  { type: "WhatsApp", value: "+86 156 3302 2618", href: "https://wa.me/8615633022618" },
  { type: "WeChat", value: "156 3302 2618", href: "#" },
];

const categories = [
  "Electronics & Electronic Components",
  "Machinery & Industrial Equipment",
  "Hardware Products",
  "Vehicle Parts - high-level sourcing",
  "New Energy / PV / EV Parts",
  "Other industrial sourcing request",
];

const supplierStatuses = [
  "No supplier contacted yet",
  "Already have supplier quotations",
  "Need alternative suppliers",
  "Need order follow-up with current supplier",
  "Need pre-shipment / document checks",
];
---

<BaseLayout
  title="Contact CertiRun"
  description="Contact CertiRun for structured sourcing, supplier verification, and delivery follow-up support."
  canonical="/contact/"
>
  <section class="subpageHero mediaHero">
    <div class="container wide mediaHeroInner reverse">
      <div class="mediaHeroCopy">
        <p class="eyebrow">CertiRun / Contact</p>
        <h1>Send your sourcing request or execution challenge.</h1>
        <p class="lead">
          Share the product scope, target quantity, current supplier status, and delivery
          market. CertiRun will help structure the next step.
        </p>
      </div>
      <figure class="mediaHeroImage">
        <img src="/images/page-heroes/contact.webp" alt="RFQ and sourcing request contact visual" />
      </figure>
    </div>
  </section>

  <div class="pageShell">
    <section class="contactSection">
      <div class="container wide contactGrid">
        <div>
          <p class="pageBadge">Contact Methods</p>
          <h2>Reach CertiRun directly</h2>
          <p class="contactLead">
            For faster review, include photos, drawings, specifications, target quantity,
            destination market, and any current supplier information.
          </p>
          <div class="methodGrid">
            {contactMethods.map((item) => (
              <a class="methodCard" href={item.href}>
                <span>{item.type}</span>
                <strong>{item.value}</strong>
              </a>
            ))}
          </div>
        </div>

        <form
          class="contactForm"
          name="sourcing-request"
          action="/thank-you/"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="sourcing-request" />
          <input type="hidden" name="subject" value="New CertiRun sourcing request" />
          <p class="hiddenField">
            <label>Do not fill this out: <input name="bot-field" /></label>
          </p>
          <div class="formHead">
            <p class="pageBadge">Structured RFQ</p>
            <h3>Sourcing request details</h3>
          </div>
          <div class="formTwo">
            <label>
              <span>Name</span>
              <input name="name" type="text" autocomplete="name" placeholder="Your name" />
            </label>
            <label>
              <span>Email</span>
              <input name="email" type="email" autocomplete="email" placeholder="name@company.com" />
            </label>
          </div>
          <label>
            <span>Category</span>
            <select name="category">
              <option value="">Select a sourcing category</option>
              {categories.map((category) => (
                <option value={category}>{category}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Product scope</span>
            <textarea name="product_scope" rows="4" placeholder="Product name, photos or drawing notes, specifications, models, standards, or reference links"></textarea>
          </label>
          <div class="formTwo">
            <label>
              <span>Target quantity</span>
              <input name="quantity" type="text" placeholder="Example: 500 pcs, 1 set, mixed order list" />
            </label>
            <label>
              <span>Destination market</span>
              <input name="destination" type="text" placeholder="Country / region" />
            </label>
          </div>
          <label>
            <span>Current supplier status</span>
            <select name="supplier_status">
              <option value="">Select current status</option>
              {supplierStatuses.map((status) => (
                <option value={status}>{status}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Packing / document requirements</span>
            <textarea name="packing_documents" rows="4" placeholder="Label, carton, certificate, datasheet, invoice, packing list, inspection, or shipment notes"></textarea>
          </label>
          <label>
            <span>Additional details</span>
            <textarea name="message" rows="5" placeholder="Open questions, timeline, supplier links, quality concerns, or execution challenges"></textarea>
          </label>
          <button class="submitButton" type="submit">Send Request</button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contactSection{ padding:76px 0 78px; background:#fff; }
  .contactGrid{ display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:48px; align-items:start; }
  .pageBadge{
    display:inline-flex; align-items:center; justify-content:center; min-height:30px;
    padding:0 14px; margin:0 0 22px; border:1px solid rgba(10,37,64,.28);
    border-radius:8px; background:#F1F4F8; color:#0A2540;
    font-family:"Work Sans",Arial,sans-serif; font-size:.72rem; font-weight:800;
    line-height:1; letter-spacing:.16em; text-transform:uppercase;
  }
  .contactGrid h2{
    max-width:620px; font-size:clamp(1.55rem,2.05vw,2.35rem); line-height:1.1;
    letter-spacing:-.025em; font-weight:700;
  }
  .contactLead{ margin-top:18px; max-width:620px; color:var(--text-secondary); font-size:var(--type-body-lg); line-height:1.7; }
  .methodGrid{ display:grid; gap:16px; margin-top:34px; }
  .methodCard{
    display:grid; gap:8px; padding:24px; border:1px solid var(--border); border-radius:8px;
    background:#fff; box-shadow:0 8px 22px rgba(10,37,64,.04);
    transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .methodCard:hover{ transform:translateY(-2px); border-color:rgba(10,37,64,.18); box-shadow:0 14px 32px rgba(10,37,64,.08); }
  .methodCard span{ color:var(--text-secondary); font-size:.78rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .methodCard strong{ color:var(--accent); font-size:1.18rem; }
  .contactForm{
    display:grid; gap:18px; padding:30px; border:1px solid var(--border); border-radius:8px;
    background:#F7F9FC; box-shadow:0 14px 34px rgba(10,37,64,.05);
  }
  .formHead h3{ font-size:1.35rem; font-weight:800; }
  .formHead .pageBadge{ margin-bottom:14px; }
  .hiddenField{ display:none; }
  .contactForm label{ display:grid; gap:8px; }
  .contactForm label span{ color:var(--text-primary); font-weight:800; font-size:.9rem; }
  .formTwo{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  .submitButton{
    display:inline-flex; align-items:center; justify-content:center; min-height:58px; padding:0 28px;
    border:none; border-radius:8px; background:var(--accent); color:#fff; font:inherit; font-weight:800;
    cursor:pointer; box-shadow:0 12px 28px rgba(10,37,64,.18); transition:transform .16s ease, background-color .16s ease;
  }
  .submitButton:hover{ transform:translateY(-2px); background:var(--accent-hover); }
  @media (max-width:900px){
    .contactSection{ padding:56px 0; }
    .contactGrid{ grid-template-columns:1fr; }
    .contactForm{ padding:22px; }
    .formTwo{ grid-template-columns:1fr; }
  }
</style>
